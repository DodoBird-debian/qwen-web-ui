# Global RunPod defaults, read by ./deploy.sh. Never use VITE_ for secrets.
RUNPOD_API_KEY=''
# Either the URL or endpoint ID is sufficient; if both are set they must agree.
RUNPOD_ENDPOINT_URL=''
RUNPOD_ENDPOINT_ID=''
# Optional separate Turbo node. Never put either key in public/config.json.
RUNPOD_TURBO_API_KEY=''
RUNPOD_TURBO_ENDPOINT_URL=''
RUNPOD_TURBO_ENDPOINT_ID=''
# Optional IPv4 resolvers for Nginx; empty uses the LXC's /etc/resolv.conf.
NGINX_RESOLVERS=''
